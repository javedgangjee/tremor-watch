# Board settings from Waveshare's 02_lvgl_demo_v9 for this watch, with the
# demo settings left out.
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_FREERTOS_HZ=1000

# The USB task is the only writer on the USB Serial/JTAG port, which carries
# the recording. With no second console, ESP-IDF's log and its crash text go
# to UART0 only and never reach that port.
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Each app task joins the task watchdog. A task that does not check in for 5
# seconds restarts the chip, so a stuck task cannot leave the face on an old
# state.
CONFIG_ESP_TASK_WDT_TIMEOUT_S=5
CONFIG_ESP_TASK_WDT_PANIC=y

# The sensor's INT1 interrupt runs from IRAM and calls esp_timer_get_time(),
# which must stay in IRAM too. This is ESP-IDF's default.
CONFIG_ESP_TIMER_IN_IRAM=y

# LVGL settings from the same example.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
CONFIG_LV_USE_FONT_COMPRESSED=y
CONFIG_LV_TXT_BREAK_CHARS=" ,.;:-_"
CONFIG_LV_USE_IMGFONT=y

# The face uses its own Red Hat Display fonts, so no Montserrat font beyond
# LVGL's default 14 pixel one is turned on here.
